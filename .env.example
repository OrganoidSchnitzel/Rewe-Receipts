# =============================================================================
# Receipt Importer — configuration
# Copy to `.env` and fill in the secrets. All values are read at startup.
# =============================================================================

# --- Storage -----------------------------------------------------------------
# SQLite DB and stored receipt files live on a mounted volume (see compose).
DB_PATH=/app/data/receipts.db
RECEIPT_FILES_DIR=/app/data/receipts

# --- Paperless-ngx (Rewe ingestion) ------------------------------------------
PAPERLESS_URL=http://192.168.178.100:8000
# REST API token: Paperless-ngx → Settings → "My Profile" → API Auth Token.
# REQUIRED for Rewe ingestion. Leave blank only if you won't ingest from Paperless.
PAPERLESS_TOKEN=
# Rewe receipts are identified by this tag (webhook + poll both filter on it).
PAPERLESS_REWE_TAG=Rewe
# Shared secret the Paperless post-consume script must send to the webhook
# (as the X-Webhook-Token header). Generate a random string. If blank, the
# webhook is unauthenticated (fine on a trusted LAN, not recommended otherwise).
PAPERLESS_WEBHOOK_TOKEN=
# After importing a Rewe document, tag it in Paperless (non-destructive) so you
# can filter handled vs. unhandled receipts. Receipts are never deleted.
PAPERLESS_TAG_ON_IMPORT=true
PAPERLESS_PROCESSED_TAG=ReceiptImported

# --- Polling fallback --------------------------------------------------------
# Background poll of Paperless in case a webhook event is missed.
POLL_ENABLED=true
POLL_INTERVAL_SECONDS=3600

# --- Spliit ------------------------------------------------------------------
SPLIIT_URL=http://192.168.178.100:3333
SPLIIT_GROUP_ID=4rYxmoWLtDtiRmLLY3vZC
# Self-hosted Spliit's tRPC API has no auth by default — leave blank unless a
# reverse proxy in front of it requires a bearer token.
SPLIIT_API_KEY=
# Who pays the created expense. Prefer the stable participant id; the name is a
# case-insensitive fallback. If both are blank, the group's first participant
# is used. (Split is EVENLY among all current members — see README.)
SPLIIT_PAYER_PARTICIPANT_ID=
SPLIIT_PAYER_NAME=
SPLIIT_CURRENCY=EUR

# --- Ollama (AI extraction fallback for Rewe OCR) ----------------------------
# Only used for OCR lines the deterministic parser can't handle. Optional.
OLLAMA_ENABLED=false
OLLAMA_URL=http://192.168.178.100:11434
OLLAMA_MODEL=llama3.1

# --- Lidl Plus ---------------------------------------------------------------
# One-time setup: on any machine with a browser, run
#   pipx run "lidl-plus[auth]" auth     (or: pip install "lidl-plus[auth]")
# enter your Lidl account email/password + the OTP; it prints a refresh token.
# Paste it below and set LIDL_ENABLED=true. The service then runs unattended.
LIDL_ENABLED=false
LIDL_REFRESH_TOKEN=
LIDL_COUNTRY=DE
LIDL_LANGUAGE=de
LIDL_POLL_INTERVAL_SECONDS=3600
# Lidl's WAF rejects the fake "999.99.9" version the library sends, so we send a
# realistic app version instead. Bump this to the current Lidl Plus release if
# ticket calls start getting reset again (check apkmirror for the latest).
LIDL_APP_VERSION=15.30.7
LIDL_OPERATING_SYSTEM=iOs
# Optional extra header if ever needed to look more like the real app.
LIDL_USER_AGENT=

# --- Telegram notifications (optional) ---------------------------------------
# Get a push message when a new receipt is auto-imported and ready to review.
# 1) Create a bot with @BotFather -> copy the token below.
# 2) Message your bot once, open https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the numeric chat id.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Two-way: adds an "Approve & split" button to notifications and acts on presses
# via long-polling — no inbound webhook or exposed port needed. Only presses
# from TELEGRAM_CHAT_ID are honored. Set false for notification-only.
TELEGRAM_TWO_WAY=true

# --- Web server --------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
HTTP_TIMEOUT=30
# Base URL the app is reached at (used to build the link in notifications).
# Set to how YOU open it, e.g. http://192.168.178.100:8881  (no trailing slash).
APP_PUBLIC_URL=
